PORT=8787
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@murugesan.in
ADMIN_MOBILE=9361866771
ADMIN_PASSWORD=your-secure-admin-password-here

# Owner WhatsApp number for receiving orders (international format: 91 + 10-digit number)
# This is the business owner's WhatsApp number where customer orders will be sent
OWNER_WHATSAPP_NUMBER=919361866771

SEED_DEMO_DATA=false

# Upload storage configuration. Local storage is development-only.
STORAGE_PROVIDER=local
UPLOAD_DIR=server/uploads

# Database Configuration
# For local development: use SQLite (default)
# For production: use PostgreSQL connection string
# DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_URL=
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:5173

# Optional persistent image CDN/object-storage base URL.
# Configure the upload provider before using permanent production images.
CDN_BASE_URL=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Shared production rate limiting. Leave blank for local in-memory fallback.
RATE_LIMIT_STORE=memory
REDIS_URL=

# ===== Optional WhatsApp Cloud API (NOT REQUIRED — wa.me Click-to-Chat is used) =====
# Leave all of the following blank unless you specifically want Cloud API later.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_NEW_ORDER_TEMPLATE=
WHATSAPP_ORDER_CONFIRMED_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
